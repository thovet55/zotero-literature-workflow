{
  "mcp": {
    "zotero-literature": {
      // Replace with the zotero-workflow-mcp binary in YOUR virtualenv
      // (pip install "zotero-literature-workflow[mcp,pdf] @ git+https://github.com/thovet55/zotero-literature-workflow.git").
      "type": "local",
      "command": ["/path/to/your/venv/bin/zotero-workflow-mcp"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        // ZOTERO_DOTENV points the MCP process at YOUR .env file (any location).
        "ZOTERO_DOTENV": "/path/to/your/.env",
        "ZOTERO_LIBRARY_TYPE": "user"
      }
    }
  }
}
